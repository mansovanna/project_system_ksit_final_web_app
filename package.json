    "file-saver": "^2.0.5",
    "html2canvas-pro": "^2.2.3",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide": "^1.23.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "qrcode.vue": "^3.10.0",
    "tailwindcss": "^4.1.17",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.11.8",
    "vue": "^3.5.22",
    "vue-qrcode": "^2.2.2",
    "vue-router": "^4.6.3",
    "vue3-carousel": "^0.17.0"
